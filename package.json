{
  "name": "mimiclaw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mimiclaw个人智能体",
  "scripts": {
    "dev": "tsx src/app/main.ts",
    "start": "node dist/app/main.js",
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@larksuiteoapi/node-sdk": "^1.56.0",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@tencent-connect/qqbot-nodejs": "^1.0.4",
    "cheerio": "^1.2.0",
    "fast-glob": "^3.3.3",
    "openai": "^5.12.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/iarna__toml": "^2.0.5",
    "@types/node": "^22.17.0",
    "prettier": "^3.9.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
